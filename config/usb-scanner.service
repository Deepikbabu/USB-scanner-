[Unit]
Description=USB Scanner Security Engine
After=usbguard.service clamav-daemon.service local-fs.target
Wants=usbguard.service
OnFailure=usb-scanner-failure.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=__PROJECT_ROOT__
ExecStart=__PROJECT_ROOT__/run.sh --service-run
ExecStopPost=__PROJECT_ROOT__/.venv/bin/python3 __PROJECT_ROOT__/tools/usb_state_admin.py restore
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
KillSignal=SIGINT
User=root
Group=usb-scanner
RuntimeDirectory=usb-scanner
RuntimeDirectoryMode=0770
Environment=PYTHONUNBUFFERED=1
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=1G
CPUQuota=90%
ReadWritePaths=/var/lib/usb-scanner /run/usb-scanner __PROJECT_ROOT__
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
